# Clean URLs: serve foo.php under /foo without exposing the extension,
# and canonicalize direct .php requests to their clean-URL equivalent so
# each page has exactly one indexable URL.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# index.php -> the site root.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# any-other-page.php -> /any-other-page (query string, if any, is kept
# automatically by mod_rewrite since the substitution has no "?" of its own).
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Root request internally serves index.php.
RewriteRule ^$ index.php [L]

# /foo internally serves foo.php, as long as that file exists and /foo
# isn't already a real file or directory (so /assets/, /uploads/, etc.
# keep working exactly as before).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

Options -Indexes
